# Copy to .env for local runs. Never commit real values.

PORT=3000
DATABASE_URL=postgres://user:password@localhost:5432/shopify_sync
# true only when connecting to Render Postgres from outside Render
DATABASE_SSL=false
# Enables /admin endpoints (Authorization: Bearer <ADMIN_TOKEN>)
ADMIN_TOKEN=
# Public base URL used by register-webhooks (Render sets RENDER_EXTERNAL_URL)
PUBLIC_URL=

# --- Shopify ---
# The *.myshopify.com domain, not alphabiomedlabs.com
SHOPIFY_SHOP_DOMAIN=alphabiomedlabs.myshopify.com
# From the app's API credentials. The client secret also verifies webhooks.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Only for apps that give a static token (shpat_...); otherwise leave blank
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_LINE_OF_BUSINESS=Alpha BioMed

# --- Salesforce ---
# dry_run records what would be sent; live calls Salesforce
SALESFORCE_MODE=dry_run
# My Domain URL, e.g. https://yourcompany.my.salesforce.com
SF_LOGIN_URL=
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_API_VERSION=v67.0
SF_ACCOUNT_RECORD_TYPE=Customer
# Object API names for Provider Order / Order Product (check with sf-describe -- --list)
SF_ORDER_OBJECT=Provider_Order__c
SF_ORDER_LINE_OBJECT=Order_Product__c

# --- Mapping decisions (agree these with the Salesforce team) ---
# none | customer_metafield | customer_tag | shopify_customer_id
PROVIDER_ID_STRATEGY=none
# For customer_metafield: the metafield's "namespace.key" (Shopify admin ->
# Settings -> Custom data -> Customers -> Provider ID)
PROVIDER_ID_METAFIELD=
PROVIDER_ID_TAG_PREFIX=provider:
PROVIDER_ID_PREFIX=SHOPIFY-
# Send Shopify orders as Provider Orders (needs the read_orders scope)
ORDER_SYNC_ENABLED=false

# --- Worker ---
WORKER_ENABLED=true
WORKER_INTERVAL_MS=5000
WORKER_BATCH_SIZE=10
WORKER_MAX_ATTEMPTS=8

# --- GoHighLevel (leads -> Salesforce Lead) ---
# Private Integration token + Location ID per sub-account
GHL_ABM_TOKEN=
GHL_ABM_LOCATION_ID=
GHL_SYNC_TOKEN=
GHL_SYNC_LOCATION_ID=
# Secret in the GHL Workflow webhook URL (?secret=...)
GHL_WEBHOOK_SECRET=
# Send GHL leads as Salesforce Leads
LEAD_SYNC_ENABLED=false
# Contacts with exactly this tag get LeadSource "Black Stag"
GHL_AD_LEAD_TAG=bsd-lead
# Optional overrides of the lead pipeline/stage ids
# GHL_ABM_PIPELINE_ID= GHL_ABM_STAGE_ID= GHL_SYNC_PIPELINE_ID= GHL_SYNC_STAGE_ID=
